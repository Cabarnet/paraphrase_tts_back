# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: секрет, который должны присылать клиенты в заголовке X-App-Key.
# Если пусто - проверка отключена.
APP_API_KEY=

# Необязательно: переопределить модели и поведение при перегрузке Gemini
# GEMINI_TEXT_MODEL=gemini-3-flash-preview
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Запасные текстовые модели через запятую — на случай ответа 503 «high demand»
# GEMINI_TEXT_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
# Предел на один вызов модели и общий бюджет на все попытки, мс
# GEMINI_CALL_TIMEOUT_MS=20000
# GEMINI_TOTAL_BUDGET_MS=45000

# Groq — второй провайдер в цепочке со своим пулом квот (бесплатно 1000 запросов
# и 200 000 токенов в сутки). Без ключа Groq просто не участвует в цепочке.
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=
# Модель Groq; альтернатива для сравнения на русском: qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b
# Рассуждения модели тратят суточную квоту токенов, для перефразировки не нужны
# GROQ_REASONING_EFFORT=low

# Railway задаёт PORT автоматически; локально можно указать свой
# PORT=3000
