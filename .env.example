# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: секрет, который должны присылать клиенты в заголовке X-App-Key.
# Если пусто - проверка отключена.
APP_API_KEY=

# Необязательно: переопределить модели и поведение при перегрузке Gemini
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Запасные текстовые модели через запятую — на случай ответа 503 «high demand»
# GEMINI_TEXT_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
# Предел на один вызов модели и общий бюджет на все попытки, мс
# GEMINI_CALL_TIMEOUT_MS=20000
# GEMINI_TOTAL_BUDGET_MS=45000

# Railway задаёт PORT автоматически; локально можно указать свой
# PORT=3000
